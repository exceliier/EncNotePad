           Scope="perUserOrMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of EncNotePad is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="EncNotePad">
        <Component Id="MainExecutable" Guid="3CE234DF-57BE-45E5-9DDF-1234567890AB">
          <File Id="EncNotePadExe"
                Source="..\encnotepad\build\windows\x64\runner\Release\encnotepad.exe"
                KeyPath="yes">
            <Shortcut Id="AppStartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="EncNotePad"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
            <Shortcut Id="AppDesktopShortcut"
                      Directory="DesktopFolder"
                      Name="EncNotePad"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
          </File>

          <ProgId Id="EncNotePad.Document" Description="EncNotePad Encrypted Document" Icon="EncNotePadExe" IconIndex="0">
            <Extension Id="enp">
              <Verb Id="open" Command="Open with EncNotePad" TargetFile="EncNotePadExe" Argument="&quot;%1&quot;" />
            </Extension>
          </ProgId>
        </Component>

